<Window x:Class="DrumPracticeStudio.Views.YouTubePlaylistTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Elegir playlists"
        Icon="/Assets/DrumPracticeStudio.ico"
        Width="560" Height="560"
        MinWidth="460" MinHeight="420"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Añadir a playlists existentes"
                   FontSize="21" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1"
                   Text="Busca por nombre y marca una o varias playlists de Drumless."
                   Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,7,0,16" />

        <TextBox x:Name="PlaylistSearchBox"
                 Grid.Row="2"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,12"
                 AutomationProperties.Name="Buscar playlists"
                 AutomationProperties.AutomationId="YouTubePlaylistTargetSearchBox" />

        <Border Grid.Row="3"
                Background="#11141B"
                BorderBrush="{StaticResource Stroke}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6">
            <ListBox ItemsSource="{Binding VisibleOptions}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="YouTubePlaylistTargetList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Content="{Binding Playlist.Name}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ItemCountLabel}"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,4,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="ValidationText"
                   Grid.Row="4"
                   Foreground="#FF7A7A"
                   Margin="0,10,0,0"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}"
                    Content="Cancelar"
                    Click="OnCancelClick" />
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Añadir"
                    Margin="8,0,0,0"
                    Click="OnAddClick"
                    AutomationProperties.AutomationId="ConfirmYouTubePlaylistTargetsButton" />
        </StackPanel>
    </Grid>
</Window>
