<Window x:Class="DrumPracticeStudio.Views.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playlist · Drum Practice Studio" Icon="/Assets/DrumPracticeStudio.ico"
        Width="900" Height="720"
        MinWidth="560" MinHeight="420" Background="{StaticResource AppBackground}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="SelectionVisibility" />
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PLAYLIST FLOTANTE" Foreground="{StaticResource Accent}"
                           FontSize="10" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedPlaylist.Name, TargetNullValue=Sin playlist}"
                           FontSize="28" FontWeight="SemiBold" Margin="0,4,12,2"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPlaylist.Name}" />
                <TextBlock Text="{Binding SelectedPlaylistSummary}"
                           Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding VisiblePlaylists}"
                      SelectedItem="{Binding SelectedPlaylist}" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="FloatingPlaylistSelector">
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Name}" Foreground="#151820" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding PlaylistItemSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,10,0" ToolTip="Buscar dentro de la playlist"
                         AutomationProperties.Name="Buscar en la playlist"
                         AutomationProperties.AutomationId="FloatingPlaylistSearchTextBox" />
                <StackPanel Grid.Column="1">
                    <WrapPanel>
                        <Button x:Name="FloatingPlayButton" Style="{StaticResource PrimaryButton}"
                                Content="▶" Padding="10,7" Margin="0,0,6,0" IsEnabled="False"
                                Click="OnPlaySelectionClick" ToolTip="Reproducir el elemento seleccionado" />
                        <Button x:Name="FloatingSelectButton" Style="{StaticResource SecondaryButton}"
                                Content="Seleccionar" Padding="10,7" Click="OnToggleSelectionClick"
                                AutomationProperties.AutomationId="FloatingSelectButton" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,9"
                           Visibility="{Binding IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SelectionVisibility}}">
                    <Button Style="{StaticResource SecondaryButton}" Content="Seleccionar todos"
                            Click="OnSelectAllClick" Padding="10,7" Margin="0,0,6,0"
                            ToolTip="Seleccionar todos los elementos visibles"
                            AutomationProperties.AutomationId="FloatingSelectAllButton" />
                    <Button x:Name="FloatingMoveUpButton" Style="{StaticResource SecondaryButton}"
                            Content="↑" Padding="9,7" Margin="0,0,6,0" IsEnabled="False"
                            Click="OnMoveSelectionUpClick" ToolTip="Subir los elementos seleccionados"
                            AutomationProperties.Name="Subir selección" />
                    <Button x:Name="FloatingMoveDownButton" Style="{StaticResource SecondaryButton}"
                            Content="↓" Padding="9,7" Margin="0,0,6,0" IsEnabled="False"
                            Click="OnMoveSelectionDownClick" ToolTip="Bajar los elementos seleccionados"
                            AutomationProperties.Name="Bajar selección" />
                    <Button x:Name="FloatingRemoveButton" Style="{StaticResource SecondaryButton}"
                            Content="Quitar" Padding="9,7" IsEnabled="False"
                            Click="OnRemoveSelectionClick"
                            ToolTip="Quitar los elementos seleccionados; no elimina los orígenes" />
                    <TextBlock x:Name="FloatingSelectionSummary" Text="0 seleccionados"
                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </WrapPanel>
            <ListBox x:Name="FloatingPlaylistList" Grid.Row="1"
                     ItemsSource="{Binding VisiblePlaylistItems}" SelectedItem="{Binding SelectedPlaylistItem}"
                     SelectionMode="Single" SelectionChanged="OnSelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     HorizontalContentAlignment="Stretch"
                     AllowDrop="True" PreviewMouseLeftButtonDown="OnDragStart"
                     PreviewMouseMove="OnPreviewMouseMove" Drop="OnDrop"
                     PreviewMouseWheel="OnPlaylistMouseWheel"
                     MouseDoubleClick="OnItemDoubleClick"
                     AutomationProperties.AutomationId="FloatingPlaylistList">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="8,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Margin="0,0,12,0" VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"
                                          Visibility="{Binding IsSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SelectionVisibility}}"
                                          AutomationProperties.Name="{Binding Title}" />
                                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    <TextBlock Text="{Binding AvailabilityLabel}" Foreground="{StaticResource Accent}"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextSecondary}"
                                               FontSize="10" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Pulsa Seleccionar para ordenar o quitar elementos. Puedes añadir pistas desde la biblioteca arrastrándolas aquí."
                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Anterior" Padding="11,7" Margin="0,0,6,0"
                        Command="{Binding PreviousTrackCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Reproducir cola" Padding="11,7" Margin="0,0,6,0"
                        Command="{Binding PlayPlaylistQueueCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Siguiente" Padding="11,7"
                        Command="{Binding NextTrackCommand}" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
